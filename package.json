{
  "name": "vinyl-vault-alexa",
  "version": "0.1.0",
  "private": true,
  "description": "An Alexa skill that answers questions about the record collection kept in Vinyl Value Vault.",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run types && npm run typecheck && npm test"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@msw/cloudflare": "^0.2.0",
    "@types/node": "^26.6.4",
    "msw": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
